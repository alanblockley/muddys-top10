{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Muddy's Top 10 Infographic Render Input",
  "type": "object",
  "required": ["week", "chart", "chartTalk", "stats", "facts", "numbers"],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "object",
      "required": ["start", "end", "display"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "display": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant": { "enum": ["standard", "feature-climber", "feature-number-one", "feature-long-run"] },
        "featured_story": { "type": "string" }
      }
    },
    "chart": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["position", "artist", "title", "plays", "movement"],
        "additionalProperties": false,
        "properties": {
          "position": { "type": "integer", "minimum": 1, "maximum": 10 },
          "artist": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "plays": { "type": "integer", "minimum": 0 },
          "movement": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["new", "up", "down", "same", "reentry"] },
              "places": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "chartBadges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["position", "label"],
        "additionalProperties": false,
        "properties": {
          "position": { "type": "integer", "minimum": 1, "maximum": 10 },
          "label": { "type": "string", "minLength": 1 },
          "tone": { "enum": ["new", "up", "down", "feature"] }
        }
      }
    },
    "chartTalk": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["slot", "kind", "heading", "body"],
        "additionalProperties": false,
        "properties": {
          "slot": { "type": "integer", "minimum": 1, "maximum": 6 },
          "kind": { "type": "string", "minLength": 1 },
          "icon": { "enum": ["trophy", "rocket", "star", "note", "music", "weeks", "climber"] },
          "emphasis": { "enum": ["normal", "feature"] },
          "heading": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "short_body": { "type": "string", "minLength": 1 },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" }
              ]
            }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["newEntries", "climbers", "fallers", "nonMovers"],
      "additionalProperties": false,
      "properties": {
        "newEntries": { "type": "integer", "minimum": 0 },
        "climbers": { "type": "integer", "minimum": 0 },
        "fallers": { "type": "integer", "minimum": 0 },
        "nonMovers": { "type": "integer", "minimum": 0 }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "numbers": {
      "type": "object",
      "required": ["totalPlaysThisWeek", "totalPlaysLastWeek", "percentageChange", "weeksSinceLaunch", "differentArtists"],
      "additionalProperties": false,
      "properties": {
        "totalPlaysThisWeek": { "type": "integer", "minimum": 0 },
        "totalPlaysLastWeek": { "type": "integer", "minimum": 0 },
        "percentageChange": { "type": "number" },
        "weeksSinceLaunch": { "type": "integer", "minimum": 0 },
        "differentArtists": { "type": "integer", "minimum": 0 }
      }
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string" },
        "day": { "type": "string" },
        "presenters": { "type": "string" },
        "presenterTagline": { "type": "string" },
        "venueName": { "type": "string" },
        "venueTagline": { "type": "string" },
        "compiledFrom": { "type": "string" }
      }
    }
  }
}
